# Copy to /etc/casaos/zimaos-easytier-web.conf and edit as needed.
# This file is loaded by zimaos-easytier-web.service via EnvironmentFile.
#
# Service startup args are fixed in the unit:
#   /usr/bin/zimaos-easytier-web \
#     --db /var/lib/casaos/et.db \
#     --config-server-protocol tcp \
#     --api-server-port 41231 \
#     --api-server-addr 127.0.0.1 \
#     --disable-registration

# Required for meshtier token auth when requests are not using web login session.
ZIMAOS_EASYTIER_WEB_AUTH_JWKS_URL=http://127.0.0.1:37815/.well-known/jwks.json

# Auto-register route to zimaos-gateway management API when easytier-web starts.
# Set false to disable startup route registration.
ZIMAOS_EASYTIER_WEB_GATEWAY_REGISTER_ROUTE=true
# Route path registered in gateway, must start with "/" and cannot be "/".
ZIMAOS_EASYTIER_WEB_GATEWAY_ROUTE=/mt
# Also auto-register API route for frontend calls.
ZIMAOS_EASYTIER_WEB_GATEWAY_REGISTER_API_ROUTE=true
# API route path registered in gateway for easytier-web auth/rest API.
ZIMAOS_EASYTIER_WEB_GATEWAY_API_ROUTE=/api/v1
# Optional override for gateway management URL file path.
# If empty, easytier-web tries /run/casaos/management.url then /var/run/casaos/management.url.
ZIMAOS_EASYTIER_WEB_GATEWAY_MANAGEMENT_URL_FILE=/run/casaos/management.url
# Startup wait time (seconds) for gateway management url file.
# Increase this when gateway starts slower than easytier-web.
ZIMAOS_EASYTIER_WEB_GATEWAY_REGISTER_WAIT_SECS=300
