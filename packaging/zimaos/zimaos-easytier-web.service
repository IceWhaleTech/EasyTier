[Unit]
Description=ZimaOS EasyTier Web Control
Wants=network-online.target
After=network-online.target network.service

[Service]
Type=simple
EnvironmentFile=-/etc/casaos/zimaos-easytier-web.conf
ExecStart=/usr/bin/zimaos-easytier-web --db ${ZIMAOS_EASYTIER_WEB_DB} --config_server_port ${ZIMAOS_EASYTIER_WEB_CONFIG_SERVER_PORT} --config_server_protocol ${ZIMAOS_EASYTIER_WEB_CONFIG_SERVER_PROTOCOL} --api_server_port ${ZIMAOS_EASYTIER_WEB_API_SERVER_PORT} --api_server_addr ${ZIMAOS_EASYTIER_WEB_API_SERVER_ADDR} --disable_registration ${ZIMAOS_EASYTIER_WEB_DISABLE_REGISTRATION}
Restart=always
RestartSec=3s

[Install]
WantedBy=multi-user.target
